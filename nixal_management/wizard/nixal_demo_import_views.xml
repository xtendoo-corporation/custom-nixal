<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nixal_demo_import_wizard_form" model="ir.ui.view">
        <field name="name">nixal.demo.import.wizard.form</field>
        <field name="model">nixal.demo.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_all" type="object"
                            string="Importar los 3 ejemplos" class="btn-primary"/>
                    <button name="action_import_trade" type="object"
                            string="Solo Trade"/>
                    <button name="action_import_nc" type="object"
                            string="Solo NC"/>
                    <button name="action_import_agri" type="object"
                            string="Solo NixAl Agri"/>
                </header>
                <sheet>
                    <p>
                        Crea un flujo completo de ejemplo con datos reales por
                        cada línea de negocio (pedido/compra → factura → cobro/pago),
                        directamente en la compañía correspondiente:
                    </p>
                    <ul>
                        <li><b>Trade</b>: compra a Alvinesa + transporte GEODIS
                            → venta a Lipsa-BP Energía España.</li>
                        <li><b>NC</b>: suscripción anual de Alcodis.</li>
                        <li><b>NixAl Agri</b>: venta de terneros de agosto 2026.</li>
                    </ul>
                    <field name="result_message" readonly="1" invisible="not result_message"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
